PORT=4000
DATABASE_URL=postgres://myhealthpal:myhealthpal_dev@localhost:5432/myhealthpal
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520

# Signs/verifies session tokens (guest, Google, and Apple sign-in all issue
# one the same way after authenticating). Required for a stable secret
# across restarts - if unset, a random one is generated per-process, which
# invalidates every session on the next restart. Generate with e.g.
# `openssl rand -hex 32`.
JWT_SECRET=
# Google OAuth Web Client ID (from Google Cloud Console -> APIs & Services
# -> Credentials). Not a secret - safe to expose to the client. Leave unset
# to hide the "Sign in with Google" option entirely.
GOOGLE_CLIENT_ID=
# Apple "Sign in with Apple" Services ID (from the Apple Developer portal).
# Not a secret. Leave unset to hide the "Sign in with Apple" option.
APPLE_CLIENT_ID=

# Gmail integration (Settings -> Connected Health Sources). A *separate*
# Google Cloud OAuth client from GOOGLE_CLIENT_ID above - this one needs a
# client secret and redirect URI to run the server-side Authorization Code
# flow that obtains an offline (refresh-able) Gmail-scoped token. Leave
# GMAIL_CLIENT_ID unset to hide the feature entirely.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the GMAIL_CLIENT_ID OAuth
# client in Google Cloud Console, e.g. https://api.myhealthpal.example/api/integrations/gmail/callback
GMAIL_REDIRECT_URI=
# Encrypts stored Gmail refresh tokens at rest (AES-256-GCM). Required for a
# stable key across restarts - same reasoning as JWT_SECRET. Generate with
# `openssl rand -hex 32`.
GMAIL_TOKEN_ENCRYPTION_KEY=
# How many days back an initial Gmail search/sync (no checkpoint yet) looks.
GMAIL_INITIAL_SEARCH_WINDOW_DAYS=180

# Extraction provider: "heuristic" (default, local, no external calls) or
# "claude". Scanned/photographed reports (image_scanned - no selectable PDF
# text, or a .jpg/.png upload) can only be read under "claude": it's the only
# provider with vision support, so under "heuristic" they're always left at
# extraction_status "OCR Pending" with zero results.
EXTRACTION_PROVIDER=heuristic
# Report narrative summary provider: "heuristic" (default) or "claude".
SUMMARY_PROVIDER=heuristic
# Insight phrasing provider: "heuristic" (default) or "claude".
INSIGHT_PROVIDER=heuristic
# Diet recommendation tip-phrasing provider: "heuristic" (default) or
# "claude". Diet photo scanning itself always requires ANTHROPIC_API_KEY
# regardless of this setting - there is no heuristic vision substitute,
# the same as medication scanning.
DIET_PROVIDER=heuristic
# Chat assistant provider: "claude" or "unavailable" (default: "claude" if
# ANTHROPIC_API_KEY is set, else "unavailable" — there is no heuristic chat
# option, since natural-language Q&A genuinely requires an LLM).
CHAT_PROVIDER=
# Required for EXTRACTION_PROVIDER=claude, SUMMARY_PROVIDER=claude,
# INSIGHT_PROVIDER=claude, or CHAT_PROVIDER=claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Optional: override/extend the per-model prices (USD per 1M tokens) used to
# estimate AI usage cost in Settings > AI usage and `npm run ai-usage-report`,
# e.g. {"claude-sonnet-5":{"input":2,"output":10,"cacheRead":0.2}}.
AI_PRICING_JSON=

# Retest Radar push reminders run hourly inside the API process (sent only
# 03:00-15:00 UTC, once per plan/kind). Set to "off" to disable, e.g. on a
# local copy pointed at real users' data. `npm run retest-reminders` runs one
# pass immediately for testing.
RETEST_REMINDERS=

# Retest Radar "Book test" link; {test} becomes the URL-encoded test name.
# Point at a lab partner's booking/search page. Default: a nearby-labs map
# search.
LAB_BOOKING_URL_TEMPLATE=

# --- Medical-file vault (issue #104; see docs/security/) ---------------------
# Every uploaded report/scan is stored only as AES-256-GCM ciphertext in
# ENCRYPTED_STORE_DIR, with a per-file data key wrapped by the key provider.
# Production (NODE_ENV=production) refuses to start unless KEY_PROVIDER=aws-kms
# and KMS_KEY_ID are set, and the EC2 instance role can use that key.
NODE_ENV=
KEY_PROVIDER=
# KMS key ARN, key id, or alias (e.g. alias/myhealthpal-reports).
KMS_KEY_ID=
KMS_REGION=ap-southeast-1
# Development/test only (KEY_PROVIDER=local-dev): `openssl rand -hex 32`.
# Never set in production and never commit a real value.
LOCAL_DEV_MASTER_KEY=
# Outside the git checkout in production, e.g. /var/lib/myhealthpal/vault.
ENCRYPTED_STORE_DIR=
# Original-file view links: lifetime in seconds (30-3600), optional one-time use.
DOWNLOAD_TOKEN_TTL_SECONDS=300
DOWNLOAD_TOKEN_SINGLE_USE=false
# 'allow' only until scripts/encrypt-legacy-uploads.js has run (never in production).
LEGACY_PLAINTEXT_READS=
# none | clamd (ClamAV daemon at CLAMD_HOST:CLAMD_PORT). Scanner errors reject the upload.
MALWARE_SCANNER=none
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
PARSER_TIMEOUT_MS=60000
# Days to keep medication/diet scan photos before purging them (empty = keep).
RETENTION_UNCONFIRMED_SCAN_DAYS=
# Optional separate key for hashing client IPs in audit events.
AUDIT_HASH_KEY=
